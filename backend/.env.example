# Application
PROJECT_NAME=WMS Backend API
VERSION=0.1.0
ENVIRONMENT=development
API_V1_STR=/api/v1

# HTTP
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Only enable when the browser must send cookies (this API uses Bearer tokens).
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=1048576

# Rate limiting (per client IP, in-process memory). Auth routes have their own limits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_LOGIN=30/minute
RATE_LIMIT_REFRESH=60/minute

# Reverse proxy addresses allowed to set X-Forwarded-For/Proto (Uvicorn).
# Set this to your proxy's IP/CIDR; never use "*" if the API is directly reachable.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Database
POSTGRES_USER=wms_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wms
# DATABASE_URL=postgresql+asyncpg://wms_app:change-me@localhost:5432/wms
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=wms-backend
JWT_AUDIENCE=wms-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Tests (optional). Defaults to POSTGRES_DB=wms_test on the same server.
# TEST_DATABASE_URL=postgresql+asyncpg://wms_app:change-me@localhost:5432/wms_test
